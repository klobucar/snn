   <style>.divTable{
	display: table;
	width: 100%;
}
.divTableBody {
	display: table-row-group;
}
.divTableRow {
	display: table-row;
}
.divTableHeading {
	background-color: #EEE;
	font-weight: bold;
	text-align: center;
}
.divTableCell, .divTableHeading {
	border: 1px solid #999999;
	display: table-cell;
	padding: 3px 10px;
	width: 27%;
}
.divTableCell1, .divTableCell3, .divTableCell4 {
	text-align: center;
}
.divTableCell1 {
	width 10%;
}

dl.AuditorHistory dt {
	float: none;
	clear: left;
	width: 100%;
	padding: .5em 0 0 0;
	text-align: left;
	font-weight: bold;
}
dl.AuditorHistory dd {
	margin: 0 0 0 50px;
	padding: 0 0 .5em 0;
}

table.RecordingFees { 
    background: white;
    border: 5px solid white;
    border-spacing: 5px;
    margin-left: auto; 
    margin-right: auto;
}
table.RecordingFees td { 
    background: #fffcf1;
    border: 5px solid white;
    padding: 4px;
    text-align: left;
}</style>
