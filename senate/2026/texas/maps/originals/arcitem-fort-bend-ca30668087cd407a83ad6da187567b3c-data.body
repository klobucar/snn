"WEB_ADDRESS","openType":"_blank","value":"https://gis.fbctx.gov/","expression":null}},"styleConfig":{"themeStyle":{"quickStyleType":"tertiary"},"useCustom":true,"customStyle":{"hover":{"text":{"underline":true,"color":"var(--info-700)"},"iconProps":{"size":13}},"regular":{"text":{"color":"var(--dark)","size":"16px"}}}}},"id":"widget_67","style":{"borderRadius":null,"border":{"type":"dashed","color":"rgba(0,0,0,0)","width":"2px"}}},"widget_68":{"uri":"widgets/common/button/","version":"1.16.0","label":"Button 6","config":{"functionConfig":{"text":"Contact Us","textExpression":null,"icon":{"data":{"svg":"<svg xmlns=\"http://www.w3.org/2000/svg\" fill=\"none\" viewBox=\"0 0 16 16\"><path fill=\"#000\" d=\"M14 2a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H2a2 2 0 0 1-2-2V3.986l.001-.024L0 4a2 2 0 0 1 2-2zm1 2.934L8.277 9.416a.5.5 0 0 1-.554 0L1 4.935V12a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1zM14 3H2a1 1 0 0 0-.97.752L8 8.398l6.97-4.646A1 1 0 0 0 14 3\"></path></svg>","properties":{"filename":"Mail 2","color":"var(--dark-800)","originalName":"outlined/application/email.svg","path":["general","envelope2"],"isUploaded":false,"inlineSvg":true}},"position":"LEFT"},"linkParam":{"linkType":"WEB_ADDRESS","openType":"_blank","value":"mailto:gisit@fortbendcountytx.gov","expression":null}},"styleConfig":{"themeStyle":{"quickStyleType":"tertiary"},"useCustom":true,"customStyle":{"hover":{"text":{"underline":true,"color":"var(--info-700)"},"iconProps":{"size":13}},"regular":{"text":{"color":"var(--dark)","size":"16px"}}}}},"id":"widget_68","style":{"borderRadius":null,"border":{"type":"dashed","color":"rgba(0,0,0,0)","width":"2px"}}},"widget_69":{"uri":"widgets/common/button/","version":"1.16.0","label":"Button 7","config":{"functionConfig":{"text":"Disclaimer","textExpression":null,"icon":{"data":{"svg":"<svg xmlns=\"http://www.w3.org/2000/svg\" fill=\"none\" viewBox=\"0 0 16 16\"><path fill=\"#000\" fill-rule=\"evenodd\" d=\"M10.373 5.57 8 .5 5.625 5.57 0 6.23l4.158 3.792L3.056 15.5 8 12.773l4.944 2.727-1.103-5.478L16 6.229zM8 2.857l1.705 3.641 4.002.469-2.957 2.697.788 3.918L8 11.631l-3.539 1.951.79-3.918-2.959-2.697 4.002-.469z\" clip-rule=\"evenodd\"></path></svg>","properties":{"filename":"Star 2","color":"var(--dark-800)","originalName":"outlined/application/star.svg","path":["general","star2"],"isUploaded":false,"inlineSvg":true}},"position":"LEFT"},"linkParam":{"linkType":"DIALOG","value":"dialog_2"}},"styleConfig":{"themeStyle":{"quickStyleType":"tertiary"},"useCustom":true,"customStyle":{"hover":{"text":{"underline":true,"color":"var(--info-700)"},"iconProps":{"size":13}},"regular":{"text":{"size":"16px","color":"var(--dark)"}}}}},"id":"widget_69","style":{"borderRadius":null,"border":{"type":"dashed","color":"rgba(0,0,0,0)","width":"2px"}}},"widget_76":{"uri":"widgets/common/text/","version":"1.16.0","label":"Text 3","config":{"text":"","placeholder":"<p><span style=\"color: var(--dark-800);\">Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor incididunt ut labore et dolore magna aliqua.</span></p>","style":{"verticalAlign":"start","wrap":true}},"id":"widget_76"},"widget_77":{"uri":"widgets/common/navigator/","version":"1.16.0","label":"Views Navigation","config":{"data":{"type":"AUTO","section":"section_3","views":[]},"display":{"advanced":true,"vertical":false,"type":"nav","navStyle":"default","standard":{"scrollable":true,"textAlign":"center","gap":"10px","showText":true,"showIcon":false,"iconPosition":"start"},"variant":{"item":{"default":{"size":"23px","borderRadius":"2px","color":"#ffffff","bg":"var(--org-header-bg)"},"active":{"size":"23px","underline":true,"color":"#049546","bold":true},"hover":{"size":"23px","color":"#96cbff"}},"root":{"bg":"var(--org-header-bg)"}}}},"id":"widget_77"},"widget_78":{"uri":"widgets/arcgis/measurement/","version":"1.16.0","label":"Measurement","config":{"enableDistance":true,"defaultDistanceUnit":"us-feet","enableArea":true,"defaultAreaUnit":"acres","arrangement":"CLASSIC"},"id":"widget_78","useMapWidgetIds":["widget_1"]},"widget_79":{"uri":"widgets/common/text/","version":"1.16.0","label":"Text 4","config":{"text":"<p><strong style=\"color: var(--dark-800); font-size: 24px; background-color: rgb(7, 45, 72); letter-spacing: normal; font-family: &quot;Avenir Next&quot;, &quot;Helvetica Neue&quot;, sans-serif, &quot;PingFang SC&quot;, &quot;Microsoft YaHei&quot;;\">﻿Turning Layers On &amp; Off</strong></p>"},"id":"widget_79"},"widget_80":{"uri":"widgets/common/text/","version":"1.16.0","label":"Text 5","config":{"text":"<ol><li data-list=\"bullet\" style=\"text-align: left;\"><span class=\"ql-ui\" contenteditable=\"false\"></span>﻿<span style=\"letter-spacing: normal; font-family: &quot;Avenir Next&quot;, &quot;Helvetica Neue&quot;, sans-serif, &quot;PingFang SC&quot;, &quot;Microsoft YaHei&quot;; color: var(--dark); font-size: 18px; background-color: rgba(0, 0, 0, 0);\">Layers embedded into the map can be turned on &amp; off. Click the highlighted </span><strong style=\"letter-spacing: normal; font-family: &quot;Avenir Next&quot;, &quot;Helvetica Neue&quot;, sans-serif, &quot;PingFang SC&quot;, &quot;Microsoft YaHei&quot;; color: var(--dark); font-size: 18px; background-color: rgba(0, 0, 0, 0);\"><em>Layer List</em></strong><span style=\"letter-spacing: normal; font-family: &quot;Avenir Next&quot;, &quot;Helvetica Neue&quot;, sans-serif, &quot;PingFang SC&quot;, &quot;Microsoft YaHei&quot;; color: var(--dark); font-size: 18px; background-color: rgba(0, 0, 0, 0);\"> tool below and check the box of each layer(s) you wish to see. </span></li><li data-list=\"bullet\" class=\"ql-indent-1\" style=\"text-align: left;\"><span class=\"ql-ui\" contenteditable=\"false\"></span><span style=\"letter-spacing: normal; font-family: &quot;Avenir Next&quot;, &quot;Helvetica Neue&quot;, sans-serif, &quot;PingFang SC&quot;, &quot;Microsoft YaHei&quot;; font-size: 14px; background-color: rgba(0, 0, 0, 0); color: var(--dark);\">Hint: layers like parcels and address points will be greyed out and will not appear until you are zoomed into a smaller portion of the map. </span></li></ol><p><br></p>"},"id":"widget_80"},"widget_81":{"uri":"widgets/common/image/","version":"1.16.0","label":"Image 3","config":{"functionConfig":{"altText":"","toolTip":"","linkParam":{},"scale":"Fit","imageParam":{"url":"${appResourceUrl}/images/widget_81/1738084969842.png","originalUrl":"${appResourceUrl}/images/widget_81/1738084969842.png","fileName":"1738084969842.png","originalName":"Layerlist.png","imgSourceType":"BY_UPLOAD","fileFormat":"image/png","originalId":"1738084969842","isUseCompress":false,"originalWidth":944,"originalHeight":580},"imageDisplayQualityMode":"ORIGINAL","imgSourceType":"","srcExpression":null},"styleConfig":{}},"id":"widget_81"},"widget_82":{"uri":"widgets/common/button/","version":"1.16.0","label":"Button 8","config":{"functionConfig":{"linkParam":{"linkType":"PAGE","value":"current_page","openType":"_self"},"icon":{"data":{"svg":"<svg xmlns=\"http://www.w3.org/2000/svg\" fill=\"none\" viewBox=\"0 0 16 16\"><path fill=\"#000\" d=\"m8.745 8 6.1 6.1a.527.527 0 1 1-.745.746L8 8.746l-6.1 6.1a.527.527 0 1 1-.746-.746l6.1-6.1-6.1-6.1a.527.527 0 0 1 .746-.746l6.1 6.1 6.1-6.1a.527.527 0 0 1 .746.746z\"></path></svg>","properties":{"filename":"Close","color":"var(--dark-800)","originalName":"outlined/editor/close.svg","path":["general","close"],"isUploaded":false,"inlineSvg":true}},"position":"LEFT"},"text":"","textExpression":null},"styleConfig":{"themeStyle":{"quickStyleType":"default"},"useCustom":true,"customStyle":{"hover":{"iconProps":{"color":"#2382c8"}},"regular":{"iconProps":{"size":14,"color":"#ffffff"},"background":{"color":"rgba(0,0,0,0)","fillType":"fill"},"border":{"color":"var(--org-header-bg)","width":"1px"},"boxShadow":{"color":"rgba(0,0,0,0)"}}}}},"id":"widget_82","style":{"border":{"type":"dashed","color":"rgba(0,0,0,0)","width":"0px"}}},"widget_83":{"uri":"widgets/common/text/","version":"1.16.0","label":"Text 6","config":{"text":"<p><strong style=\"font-size: 16px; color: var(--dark-800); background-color: rgb(7, 45, 72); letter-spacing: normal; font-family: &quot;Avenir Next&quot;, &quot;Helvetica Neue&quot;, sans-serif, &quot;PingFang SC&quot;, &quot;Microsoft YaHei&quot;;\">﻿</strong><strong style=\"color: var(--dark-800); background-color: rgb(7, 45, 72); letter-spacing: normal; font-size: 13px; font-family: &quot;Avenir Next&quot;, &quot;Helvetica Neue&quot;, sans-serif, &quot;PingFang SC&quot;, &quot;Microsoft YaHei&quot;;\"> </strong><strong style=\"font-size: 24px; color: var(--dark); background-color: rgb(7, 45, 72); letter-spacing: normal; font-family: &quot;Avenir Next&quot;, &quot;Helvetica Neue&quot;, sans-serif, &quot;PingFang SC&quot;, &quot;Microsoft YaHei&quot;;\">Changing Basemap</strong></p>"},"id":"widget_83"},"widget_84":{"uri":"widgets/common/text/","version":"1.16.0","label":"Text 7","config":{"text":"<ol><li data-list=\"bullet\" style=\"text-align: left;\"><span class=\"ql-ui\" contenteditable=\"false\"></span><span style=\"background-color: rgb(7, 45, 72); letter-spacing: normal; font-family: &quot;Avenir Next&quot;, &quot;Helvetica Neue&quot;, sans-serif, &quot;PingFang SC&quot;, &quot;Microsoft YaHei&quot;; color: rgb(255, 255, 255); font-size: 18px;\">To swap basemaps, click the Basemap Gallery and switch to one of your choosing. If you wish to switch back, choose 'General Reference' or refresh your browser to return the original map.</span></li></ol><p><br></p>"},"id":"widget_84"},"widget_85":{"uri":"widgets/common/image/","version":"1.16.0","label":"Image 4","config":{"functionConfig":{"altText":"","toolTip":"","linkParam":{},"scale":"Fit","imageParam":{"url":"${appResourceUrl}/images/widget_85/1738085772832.png","originalUrl":"${appResourceUrl}/images/widget_85/1738085772832.png","fileName":"1738085772832.png","originalName":"Basemap.png","imgSourceType":"BY_UPLOAD","fileFormat":"image/png","originalId":"1738085772832","isUseCompress":false,"originalWidth":851,"originalHeight":553},"imageDisplayQualityMode":"ORIGINAL","imgSourceType":"","srcExpression":null},"styleConfig":{}},"id":"widget_85"},"widget_87":{"uri":"widgets/common/text/","version":"1.16.0","label":"Text 8","config":{"text":"<p>﻿<strong style=\"color: var(--dark-800); font-size: 16px; background-color: rgb(7, 45, 72); letter-spacing: normal; font-family: &quot;Avenir Next&quot;, &quot;Helvetica Neue&quot;, sans-serif, &quot;PingFang SC&quot;, &quot;Microsoft YaHei&quot;;\">﻿</strong><strong style=\"color: var(--dark-800); font-size: 13px; background-color: rgb(7, 45, 72); letter-spacing: normal; font-family: &quot;Avenir Next&quot;, &quot;Helvetica Neue&quot;, sans-serif, &quot;PingFang SC&quot;, &quot;Microsoft YaHei&quot;;\"> </strong><strong style=\"color: var(--dark); font-size: 24px; background-color: rgb(7, 45, 72); letter-spacing: normal; font-family: &quot;Avenir Next&quot;, &quot;Helvetica Neue&quot;, sans-serif, &quot;PingFang SC&quot;, &quot;Microsoft YaHei&quot;;\">How to Draw</strong></p>"},"id":"widget_87"},"widget_88":{"uri":"widgets/common/text/","version":"1.16.0","label":"Text 9","config":{"text":"<ol><li data-list=\"bullet\" style=\"text-align: left;\"><span class=\"ql-ui\" contenteditable=\"false\"></span>﻿<span style=\"background-color: rgb(7, 45, 72); letter-spacing: normal; font-family: &quot;Avenir Next&quot;, &quot;Helvetica Neue&quot;, sans-serif, &quot;PingFang SC&quot;, &quot;Microsoft YaHei&quot;; color: rgb(255, 255, 255); font-size: 18px;\">Users are able to draw points, lines, and polygons (area) which can be saved for future use using the </span><a href=\"https://localhost:3001/experience/dialog_4,view_4\" target=\"_self\" data-uniqueid=\"d12278d8_1715_1a74_218c_891b5c024c94\" data-dsid=\"\" data-link=\"%7B%22linkType%22%3A%22VIEW%22%2C%22value%22%3A%22dialog_4%2Cview_4%22%7D\" style=\"background-color: transparent; letter-spacing: normal; font-family: &quot;Avenir Next&quot;, &quot;Helvetica Neue&quot;, sans-serif, &quot;PingFang SC&quot;, &quot;Microsoft YaHei&quot;; color: var(--primary-600); font-size: 18px;\">Bookmark </a><span style=\"background-color: rgb(7, 45, 72); letter-spacing: normal; font-family: &quot;Avenir Next&quot;, &quot;Helvetica Neue&quot;, sans-serif, &quot;PingFang SC&quot;, &quot;Microsoft YaHei&quot;; color: rgb(255, 255, 255); font-size: 18px;\">or converted into .pdf using the </span><a href=\"https://localhost:3001/experience/dialog_4,view_5\" target=\"_self\" data-uniqueid=\"80c95484_2297_6e03_b134_8e6c4a8e9806\" data-dsid=\"\" data-link=\"%7B%22linkType%22%3A%22VIEW%22%2C%22value%22%3A%22dialog_4%2Cview_5%22%7D\" style=\"background-color: transparent; letter-spacing: normal; font-family: &quot;Avenir Next&quot;, &quot;Helvetica Neue&quot;, sans-serif, &quot;PingFang SC&quot;, &quot;Microsoft YaHei&quot;; color: var(--primary-600); font-size: 18px;\">Print </a><span style=\"background-color: rgb(7, 45, 72); letter-spacing: normal; font-family: &quot;Avenir Next&quot;, &quot;Helvetica Neue&quot;, sans-serif, &quot;PingFang SC&quot;, &quot;Microsoft YaHei&quot;; color: rgb(255, 255, 255); font-size: 18px;\">tool. </span></li><li data-list=\"bullet\" class=\"ql-indent-1\" style=\"text-align: left;\"><span class=\"ql-ui\" contenteditable=\"false\"></span><span style=\"background-color: rgb(7, 45, 72); letter-spacing: normal; font-family: &quot;Avenir Next&quot;, &quot;Helvetica Neue&quot;, sans-serif, &quot;PingFang SC&quot;, &quot;Microsoft YaHei&quot;; color: rgb(255, 255, 255); font-size: 14px;\">To draw, simply click on the highlighted draw tool and select your drawing mode. It is recommended to set the transparency to at least 40% in order to view underlying features on the map. </span></li><li data-list=\"bullet\" class=\"ql-indent-1\" style=\"text-align: left;\"><span class=\"ql-ui\" contenteditable=\"false\"></span><span style=\"background-color: rgb(7, 45, 72); letter-spacing: normal; font-family: &quot;Avenir Next&quot;, &quot;Helvetica Neue&quot;, sans-serif, &quot;PingFang SC&quot;, &quot;Microsoft YaHei&quot;; color: rgb(255, 255, 255); font-size: 14px;\">Set the area/perimeter measurement units if you wish to see these. </span></li></ol><p><br></p>"},"id":"widget_88"},"widget_89":{"uri":"widgets/common/image/","version":"1.16.0","label":"Image 5","config":{"functionConfig":{"altText":"","toolTip":"","linkParam":{},"scale":"Fit","imageParam":{"url":"${appResourceUrl}/images/widget_89/1738086035043.png","originalUrl":"${appResourceUrl}/images/widget_89/1738086035043.png","fileName":"1738086035043.png","originalName":"Draw.png","imgSourceType":"BY_UPLOAD","fileFormat":"image/png","originalId":"1738086035043","isUseCompress":false,"originalWidth":851,"originalHeight":551},"imageDisplayQualityMode":"ORIGINAL","imgSourceType":"","srcExpression":null},"styleConfig":{}},"id":"widget_89"},"widget_95":{"uri":"widgets/common/text/","version":"1.16.0","label":"Text 10","config":{"text":"<p>﻿<strong style=\"color: var(--dark-800); font-size: 24px; background-color: rgb(7, 45, 72); letter-spacing: normal; font-family: &quot;Avenir Next&quot;, &quot;Helvetica Neue&quot;, sans-serif, &quot;PingFang SC&quot;, &quot;Microsoft YaHei&quot;;\">Print</strong></p>"},"id":"widget_95"},"widget_96":{"uri":"widgets/common/text/","version":"1.16.0","label":"Text 11","config":{"text":"<ol><li data-list=\"bullet\" style=\"text-align: left;\"><span class=\"ql-ui\" contenteditable=\"false\"></span><span style=\"background-color: rgb(7, 45, 72); letter-spacing: normal; font-family: &quot;Avenir Next&quot;, &quot;Helvetica Neue&quot;, sans-serif, &quot;PingFang SC&quot;, &quot;Microsoft YaHei&quot;; color: rgb(255, 255, 255); font-size: 18px;\">Using the Print tool, you will be able to generate a .pdf file of your map and save to your local computer to keep or print. </span></li><li data-list=\"ordered\" class=\"ql-indent-1\" style=\"text-align: left;\"><span class=\"ql-ui\" contenteditable=\"false\"></span><span style=\"background-color: rgb(7, 45, 72); letter-spacing: normal; font-family: &quot;Avenir Next&quot;, &quot;Helvetica Neue&quot;, sans-serif, &quot;PingFang SC&quot;, &quot;Microsoft YaHei&quot;; color: rgb(255, 255, 255); font-size: 18px;\">Choose your template, give it a name then select </span><strong style=\"background-color: rgb(7, 45, 72); letter-spacing: normal; font-family: &quot;Avenir Next&quot;, &quot;Helvetica Neue&quot;, sans-serif, &quot;PingFang SC&quot;, &quot;Microsoft YaHei&quot;; color: rgb(255, 255, 255); font-size: 18px;\">Print</strong></li><li data-list=\"ordered\" class=\"ql-indent-1\" style=\"text-align: left;\"><span class=\"ql-ui\" contenteditable=\"false\"></span><span style=\"background-color: rgb(7, 45, 72); letter-spacing: normal; font-family: &quot;Avenir Next&quot;, &quot;Helvetica Neue&quot;, sans-serif, &quot;PingFang SC&quot;, &quot;Microsoft YaHei&quot;; color: rgb(255, 255, 255); font-size: 18px;\">After it has been generated, click on the </span><strong style=\"background-color: rgb(7, 45, 72); letter-spacing: normal; font-family: &quot;Avenir Next&quot;, &quot;Helvetica Neue&quot;, sans-serif, &quot;PingFang SC&quot;, &quot;Microsoft YaHei&quot;; color: rgb(255, 255, 255); font-size: 18px;\">Results </strong><span style=\"background-color: rgb(7, 45, 72); letter-spacing: normal; font-family: &quot;Avenir Next&quot;, &quot;Helvetica Neue&quot;, sans-serif, &quot;PingFang SC&quot;, &quot;Microsoft YaHei&quot;; color: rgb(255, 255, 255); font-size: 18px;\">tab</span></li><li data-list=\"ordered\" class=\"ql-indent-1\" style=\"text-align: left;\"><span class=\"ql-ui\" contenteditable=\"false\"></span><span style=\"background-color: rgb(7, 45, 72); letter-spacing: normal; font-family: &quot;Avenir Next&quot;, &quot;Helvetica Neue&quot;, sans-serif, &quot;PingFang SC&quot;, &quot;Microsoft YaHei&quot;; color: rgb(255, 255, 255); font-size: 18px;\">Open the document by clicking on the link. This will open the .pdf in your web browser. From there you will be able to save to your local computer or click the Print icon. </span></li></ol><p><br></p>"},"id":"widget_96"},"widget_97":{"uri":"widgets/common/image/","version":"1.16.0","label":"Image 6","config":{"functionConfig":{"altText":"","toolTip":"","linkParam":{"linkType":"NONE","openType":"_self"},"scale":"Fit","imageParam":{"url":"${appResourceUrl}/images/widget_92/1738086322421.png","originalUrl":"${appResourceUrl}/images/widget_92/1738086322421.png","fileName":"1738086322421.png","originalName":"Print1.png","imgSourceType":"BY_UPLOAD","fileFormat":"image/png","originalId":"1738086322421","isUseCompress":false,"originalWidth":452,"originalHeight":375},"imageDisplayQualityMode":"ORIGINAL","imgSourceType":"","srcExpression":null},"styleConfig":{}},"id":"widget_97","useDataSources":[]},"widget_98":{"uri":"widgets/common/image/","version":"1.16.0","label":"Image 7","config":{"functionConfig":{"altText":"","toolTip":"","linkParam":{},"scale":"Fit","imageParam":{"url":"${appResourceUrl}/images/widget_93/1738086335079.png","originalUrl":"${appResourceUrl}/images/widget_93/1738086335079.png","fileName":"1738086335079.png","originalName":"Print2.png","imgSourceType":"BY_UPLOAD","fileFormat":"image/png","originalId":"1738086335079","isUseCompress":false,"originalWidth":369,"originalHeight":373},"imageDisplayQualityMode":"ORIGINAL","imgSourceType":"","srcExpression":null},"styleConfig":{}},"id":"widget_98"},"widget_99":{"uri":"widgets/common/image/","version":"1.16.0","label":"Image 8","config":{"functionConfig":{"altText":"","toolTip":"","linkParam":{},"scale":"Fit","imageParam":{"url":"${appResourceUrl}/images/widget_94/1738086339679.png","originalUrl":"${appResourceUrl}/images/widget_94/1738086339679.png","fileName":"1738086339679.png","originalName":"Print3.png","imgSourceType":"BY_UPLOAD","fileFormat":"image/png","originalId":"1738086339679","isUseCompress":false,"originalWidth":452,"originalHeight":374},"imageDisplayQualityMode":"ORIGINAL","imgSourceType":"","s