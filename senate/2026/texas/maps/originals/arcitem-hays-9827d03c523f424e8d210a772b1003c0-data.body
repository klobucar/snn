{"source":"7c5f70d91e6b4a5d9c7ee877142d77a6","folderId":"e2369dd8f169480b9915c1c39b8b40a8","values":{"webmap":"eeeb1e20d0dc4a7fb8d2769af2f0ccb7","type":"webmap","fullAppSettings":true,"searchConfiguration":{"allPlaceholder":"Find address or place","sources":[{"url":"https://geocode.arcgis.com/arcgis/rest/services/World/GeocodeServer","singleLineFieldName":"SingleLine","name":"ArcGIS World Geocoding Service","placeholder":"Find address or place","maxResults":null,"maxSuggestions":null,"suggestionsEnabled":null,"minSuggestCharacters":null,"withinViewEnabled":false,"countryCode":null,"zoomScale":null,"_uid":"83bc8b96c04"}],"activeSourceIndex":0},"header":true,"mapA11yDesc":"Hays County Elections Data for continuous use between elections. This map displays voter addresses and voter precincts for Hays County, Texas.","search":true,"customTheme":{"applySharedTheme":false,"applyPresetTheme":true,"font":"Avenir Next","appFont":"Avenir Next","logo":"https://haysgis.maps.arcgis.com/sharing/rest/content/items/9827d03c523f424e8d210a772b1003c0/resources/media/instantAppsConfigPanel_1699458458092_CountyHaysSeal_FromODP_Nice.png","logoLink":"https://hayscountytx.gov/","logoScale":"m","preset":"ocean","themes":{"primary":{"type":"primary","background":"#005E95","text":"#FFFFFF"}}},"bookmarksPosition":{"position":"top-right","index":5},"mapZoomPosition":{"position":"top-left","index":2},"homePosition":{"position":"top-left","index":1},"compassWidgetPosition":{"position":"top-left","index":6},"locateWidgetPosition":{"position":"top-right","index":4},"measurePosition":{"position":"top-right","index":3},"keyboardShortcutsPosition":{"position":"top-left","index":5},"filterPosition":{"position":"top-right","index":2},"printPosition":{"position":"top-left","index":4},"screenshotPosition":{"position":"top-left","index":3},"sharePosition":{"position":"top-right","index":1},"searchPosition":{"position":"top-left","index":0},"languageSwitcherPosition":{"position":"top-right","index":7},"splashButtonPosition":{"position":"top-right","index":6},"searchOpenAtStart":false,"coverPage":false,"coverPageConfig":{"title":"Hays County Elections Interim App","titleColor":"#ffffff","subtitle":"subtitle","subtitleColor":"#ffffff","textPosition":"center-leading","buttonText":"Explore","buttonTextColor":"#ffffff","background":{"backgroundType":"color","backgroundImage":null,"backgroundColor":"#0079c1"}},"splash":true,"splashTitle":"Welcome to the Hays County Elections Interim App!","splashContent":"<p style=\"background-color:rgb(255, 255, 255); color:rgb(74, 74, 74); font-family:&quot;Avenir Next&quot;, Avenir, &quot;Helvetica Neue&quot;, sans-serif; font-size:16px; font-style:normal; font-variant-caps:normal; font-variant-ligatures:normal; font-weight:400; letter-spacing:normal; text-align:start; text-decoration-color:initial; text-decoration-style:initial; text-indent:0px; text-transform:none; word-spacing:0px;\">Use this app to determine which voting precinct an address belongs to with one of the following search methods in the top left corner of the app:</p><ul><li>Click the search box and type in an address.</li><li>Click the <strong>Find my location </strong>button, then allow location information to be shared.</li></ul><p style=\"background-color:rgb(255, 255, 255); color:rgb(74, 74, 74); font-family:&quot;Avenir Next&quot;, Avenir, &quot;Helvetica Neue&quot;, sans-serif; font-size:16px; font-style:normal; font-variant-caps:normal; font-variant-ligatures:normal; font-weight:400; letter-spacing:normal; text-align:start; text-decoration-color:initial; text-decoration-style:initial; text-indent:0px; text-transform:none; word-spacing:0px;\"><a style=\"color:rgb(83, 181, 238);\" href=\"https://teamrv-mvp.sos.texas.gov/MVP/mvp.do\" target=\"_blank\">Click here to check if you are registered to vote</a></p><p style=\"background-color:rgb(255, 255, 255); color:rgb(74, 74, 74); font-family:&quot;Avenir Next&quot;, Avenir, &quot;Helvetica Neue&quot;, sans-serif; font-size:16px; font-style:normal; font-variant-caps:normal; font-variant-ligatures:normal; font-weight:400; letter-spacing:normal; text-align:start; text-decoration-color:initial; text-decoration-style:initial; text-indent:0px; text-transform:none; word-spacing:0px;\">This app is only intended to provide convenient access to Hays County election data. If you believe this information is inaccurate or you would like more information, please contact the Hays County Elections Department at (512) 393-7310 or elections@co.hays.tx.us.</p>","splashButtonText":"I understand","uploads":["https://haysgis.maps.arcgis.com/sharing/rest/content/items/9827d03c523f424e8d210a772b1003c0/resources/media/instantAppsConfigPanel_1699458402664_ElectionsHaysCountyElectionsDepartmentLogo.png","https://haysgis.maps.arcgis.com/sharing/rest/content/items/9827d03c523f424e8d210a772b1003c0/resources/media/instantAppsConfigPanel_1699458439397_CountyHaysSeal.png","https://haysgis.maps.arcgis.com/sharing/rest/content/items/9827d03c523f424e8d210a772b1003c0/resources/media/instantAppsConfigPanel_1699458458092_CountyHaysSeal_FromODP_Nice.png"],"locateWidget":true,"scalebar":true,"datePublished":1729195758474,"print":true,"printAuthor":"Hays County Office of Development Services GIS Division","printTitle":"Hays County Elections Precincts Map - 2024","landingPage":null,"landingPageConfig":{"titleText":"","subtitleText":"","descriptionText":"","entryButtonText":"","alignment":"center","backgroundType":"color","textColor":"#FFFFFF","entryButtonColor":"#0079C1","backgroundColor":"#0079C1","iconImage":null,"iconImageScale":"m","backgroundImageSrc":null}}}