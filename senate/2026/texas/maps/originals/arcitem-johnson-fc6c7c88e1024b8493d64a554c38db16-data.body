{"theme":{"name":"JewelryBoxTheme","styles":["yellow","default","black","green","cyan","red","purple","blue"],"version":"2.21","sharedTheme":{"useHeader":false,"useLogo":true,"isPortalSupport":true},"customStyles":{"mainBackgroundColor":"#49497a"}},"portalUrl":"https://jocotx.maps.arcgis.com","appId":"","authorizedCrossOriginDomains":[],"title":"Johnson County Precincts Interactive Map","subtitle":"with ArcGIS Web AppBuilder","keepAppState":true,"logo":"images/app-logo.png","geometryService":"https://utility.arcgisonline.com/arcgis/rest/services/Geometry/GeometryServer","links":[],"widgetOnScreen":{"widgets":[{"uri":"themes/JewelryBoxTheme/widgets/HeaderController/Widget","position":{"left":0,"top":0,"right":0,"height":40,"relativeTo":"browser"},"version":"2.32","id":"themes_JewelryBoxTheme_widgets_HeaderController_Widget_21","name":"HeaderController"},{"uri":"widgets/Scalebar/Widget","position":{"left":7,"bottom":25,"relativeTo":"map"},"version":"2.32","id":"widgets_Scalebar_Widget_22","name":"Scalebar"},{"uri":"widgets/Search/Widget","position":{"left":55,"top":5,"relativeTo":"map"},"version":"2.32","id":"widgets_Search_Widget_23","name":"Search","config":{"allPlaceholder":"Search for Address Here","showInfoWindowOnSelect":true,"sources":[{"layerId":"18d38458a1c-layer-10","url":"https://services7.arcgis.com/gVohhGAlfFScDJGs/arcgis/rest/services/Site_Structure_Address_Points/FeatureServer/0","name":"Site Structure Address Points","placeholder":"","searchFields":["DP_Notes3"],"displayField":"DP_Notes3","exactMatch":false,"searchInCurrentMapExtent":false,"panToScale":false,"zoomScale":1000,"maxSuggestions":6,"maxResults":6,"type":"query"},{"layerId":"183906bde4e-layer-4","url":"https://services7.arcgis.com/gVohhGAlfFScDJGs/arcgis/rest/services/Burleson_Addresses/FeatureServer/0","name":"Burleson Addresses","placeholder":"","searchFields":["ADDRESS"],"displayField":"ADDRESS","exactMatch":false,"searchInCurrentMapExtent":false,"panToScale":false,"zoomScale":null,"maxSuggestions":6,"maxResults":6,"type":"query"},{"layerId":"18410b87e9a-layer-5","url":"https://services7.arcgis.com/gVohhGAlfFScDJGs/arcgis/rest/services/Mansfield_Addresses/FeatureServer/0","name":"Mansfield Addresses","placeholder":"","searchFields":["ADDRESS"],"displayField":"ADDRESS","exactMatch":false,"searchInCurrentMapExtent":false,"panToScale":false,"zoomScale":null,"maxSuggestions":6,"maxResults":6,"type":"query"}]}},{"uri":"widgets/Coordinate/Widget","position":{"left":7,"bottom":5,"relativeTo":"map"},"version":"2.32","id":"widgets_Coordinate_Widget_24","name":"Coordinate"},{"position":{"left":55,"top":45,"relativeTo":"map"},"placeholderIndex":1,"id":"_25","name":"About","label":"How to use this map","version":"2.32","closeable":true,"uri":"widgets/About/Widget","config":{"about":{"aboutContent":"<div><span style=\"background-color: rgb(128, 128, 128); color: rgb(255, 255, 255);\"><br /></span></div>\n\t<div align=\"center\" style=\"text-align: left;\"><font face=\"Arial\" style=\"color: rgb(47, 79, 79);\">This map was built to assist Johnson County residents and employees find information for their County Precinct officials based on the address location.</font></div><div align=\"center\" style=\"text-align: left;\"><font face=\"Arial\" style=\"color: rgb(47, 79, 79);\"><br /></font></div><div align=\"center\" style=\"text-align: left;\"><b><font face=\"Arial\" size=\"3\" style=\"color: rgb(45, 67, 182);\">How to use this map:</font></b></div><div align=\"center\" style=\"text-align: left;\"><font face=\"Arial\" style=\"color: rgb(47, 79, 79);\">Enter the address in the search bar above.  If the road name includes County Road, Highway, Interstate, those words must be typed out fully.  Abbreviations for these words will not return a search result.  When the address is located, the map will zoom to the location and open a text box with information about the local County Precinct officials.</font></div><div align=\"center\" style=\"text-align: left;\"><span style=\"color: rgb(47, 79, 79);\"><span style=\"font-family: Arial;\"> </span><font face=\"Arial\"><br /></font></span></div><div align=\"center\" style=\"text-align: left;\"><font face=\"Arial\" style=\"color: rgb(47, 79, 79);\">Rolling the scroll wheel on the mouse will zoom in and out on the map.</font></div><div align=\"center\" style=\"text-align: left;\"><font face=\"Arial\" style=\"color: rgb(47, 79, 79);\"><br /></font></div><div align=\"center\" style=\"text-align: left;\"><font face=\"Arial\" style=\"color: rgb(47, 79, 79);\">Panning across the map can be done by pressing and holding the left mouse button and moving the mouse.</font></div><div align=\"center\" style=\"text-align: left;\"><font face=\"Arial\" style=\"color: rgb(47, 79, 79);\"><br /></font></div><div align=\"center\" style=\"text-align: left;\"><font face=\"Arial\" style=\"color: rgb(47, 79, 79);\">If using zooming and panning to locate your address, click on the address point to open a text box containing information about local County Precinct officials.</font></div><div align=\"center\" style=\"text-align: left;\"><br /></div><div align=\"center\" style=\"text-align: left;\"><font face=\"Arial\" style=\"color: rgb(47, 79, 79);\">The button next to the &quot;i&quot; with 4 white squares will allow you to change the basemap to one of your choice.</font></div><div align=\"center\" style=\"text-align: left;\"><font face=\"Arial\" style=\"color: rgb(47, 79, 79);\"><br /></font></div><div align=\"center\" style=\"text-align: left;\"><font face=\"Arial\" style=\"color: rgb(47, 79, 79);\">The printer button will allow you to create a printable pdf from the current visible extent of the map.</font></div>"}},"openAtStart":true},{"position":{"left":105,"top":45,"relativeTo":"map"},"placeholderIndex":1,"id":"_26","name":"BasemapGallery","version":"2.32","closeable":true,"uri":"widgets/BasemapGallery/Widget","config":{"basemapGallery":{"mode":1,"basemaps":[]}}},{"position":{"left":155,"top":45,"relativeTo":"map"},"placeholderIndex":1,"id":"_27","name":"Print","version":"2.32","closeable":true,"uri":"widgets/Print/Widget","config":{"serviceURL":"https://utility.arcgisonline.com/arcgis/rest/services/Utilities/PrintingTools/GPServer/Export%20Web%20Map%20Task","defaultTitle":"ArcGIS Web Map","defaultAuthor":"ArcGIS Web AppBuilder","defaultCopyright":"This product was obtained from data provided by Johnson County GIS and Mapping","defaultFormat":"PDF","defaultLayout":"A4 Landscape","copyrightEditable":false}},{"uri":"widgets/OverviewMap/Widget","position":{"right":0,"bottom":0,"relativeTo":"map"},"version":"2.32","id":"widgets_OverviewMap_Widget_28","name":"OverviewMap"},{"uri":"widgets/HomeButton/Widget","position":{"left":7,"top":75,"relativeTo":"map"},"version":"2.32","id":"widgets_HomeButton_Widget_29","name":"HomeButton"},{"uri":"widgets/MyLocation/Widget","position":{"left":7,"top":110,"relativeTo":"map"},"version":"2.32","id":"widgets_MyLocation_Widget_30","name":"MyLocation"},{"uri":"widgets/AttributeTable/Widget","version":"2.32","position":{"relativeTo":"browser"},"id":"widgets_AttributeTable_Widget_31","name":"AttributeTable"},{"uri":"widgets/Splash/Widget","visible":false,"position":{"relativeTo":"browser"},"version":"2.32","id":"widgets_Splash_Widget_32","name":"Splash"},{"uri":"widgets/ZoomSlider/Widget","position":{"top":5,"left":7,"relativeTo":"map"},"version":"2.32","id":"widgets_ZoomSlider_Widget_33","name":"ZoomSlider"},{"uri":"widgets/ExtentNavigate/Widget","visible":false,"position":{"top":148,"left":7,"relativeTo":"map"},"version":"2.32","id":"widgets_ExtentNavigate_Widget_34","name":"ExtentNavigate"},{"uri":"widgets/FullScreen/Widget","visible":false,"position":{"right":8,"top":8,"relativeTo":"map"},"version":"2.32","id":"widgets_FullScreen_Widget_35","name":"FullScreen"}],"groups":[{"visible":false,"panel":{"uri":"themes/JewelryBoxTheme/panels/LDockablePanel/Panel","position":{"left":0,"top":40,"bottom":0,"width":360,"relativeTo":"browser"}},"maxW