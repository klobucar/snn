<script>
    var serviceDescriptions = JSON.parse('[{"name":"Court Information (non-JP)","summary":"For County Court inquiries, please call (409) 770-6044. For District Courts inquiries, please call (409) 770-5230.","serviceItemUrl":"/Home/Components/ServiceDirectory/ServiceDirectory/64/23","target":"_self","catValues":"1"},{"name":"Election Results","summary":"Test Overview","serviceItemUrl":"/?navid=1044","target":"_self","catValues":"133"},{"name":"Employee Webmail","summary":"Please click Learn More below.","serviceItemUrl":"/?navid=888","target":"_self","catValues":"95"},{"name":"Floodplain Permits","summary":"Permit Applications","serviceItemUrl":"/?navid=523","target":"_self","catValues":"3"},{"name":"Galveston County Career","summary":"Visit NeoGov to view and apply for Galveston County employment opportunities.","serviceItemUrl":"/?navid=473","target":"_blank","catValues":"3"},{"name":"Indoor Facility","summary":"Indoor Facility Information","serviceItemUrl":"/?navid=601","target":"_self","catValues":"98"},{"name":"Jury Duty Information ","summary":"Look up Jury Duty information.","serviceItemUrl":"/?navid=143","target":"_self","catValues":"95"},{"name":"Marriage License","summary":"Marriage License Information","serviceItemUrl":"/?navid=103","target":"_self","catValues":"3"},{"name":"My polling location","summary":null,"serviceItemUrl":"/?navid=1043","target":"_self","catValues":"95"},{"name":"Outdoor Picnic Pavilions","summary":"Outdoor Picnic Pavilion Information","serviceItemUrl":"/?navid=601","target":"_self","catValues":"98"},{"name":"Pay Property Taxes","summary":"Lookup/Pay Property Taxes","serviceItemUrl":"/?navid=711","target":"_self","catValues":"99"},{"name":"Register to Vote","summary":"Voter Registration","serviceItemUrl":"/?navid=170","target":"_blank","catValues":"93"},{"name":"Rodeo Arenas","summary":"Rodeo Arena Information","serviceItemUrl":"/?navid=601","target":"_self","catValues":"98"},{"name":"San Luis Toll Bridge","summary":"35930 Termini San Luis Pass Rd, Galveston, TX, 77554","serviceItemUrl":"/Home/Components/ServiceDirectory/ServiceDirectory/100/23","target":"_self","catValues":"1"},{"name":"Senior Services Program","summary":"Learn more about our community centers, activities, and transportation!","serviceItemUrl":"/?navid=575","target":"_self","catValues":"95"},{"name":"The Elections Office","summary":null,"serviceItemUrl":"/?navid=1062","target":"_self","catValues":"1"},{"name":"To be a poll worker","summary":null,"serviceItemUrl":"/?navid=1051","target":"_self","catValues":"3"},{"name":"To vote by mail","summary":null,"serviceItemUrl":"/?navid=1068","target":"_self","catValues":"3"}]');
    
    
    console.log(serviceDescriptions);
    
    function ResetCategoryAndServices() {
        
        var firstVisibleOnLoad = '';
        
        $('#category-2').empty();
        
        $.each(serviceDescriptions, function(index, value) {
        
            var categoryArray = value.catValues.split(' ');
        
            if (categoryArray.indexOf($('#category-1').val()) >= 0) {
            
                $('#category-2').append('<option data-group="' + value.catValues + '" value="' + value.catValues + '" style="display: block;">' + value.name + '</option>');
            }
        });
            
        $('#category-2').children().each(function(){  //iterate options
        
            if($(this).css('display') != 'none'){  
                firstVisibleOnLoad = $(this).val();
                return false;   //stop iterating
            }
        });
        
        $('#category-2').val(firstVisibleOnLoad);         
    }

    function UpdateLabels() {
        
        var serviceSummary;
        var itemUrl;
        var target;
        var cat2Value = document.getElementById("category-2");
        var cat2Text = cat2Value.options[cat2Value.selectedIndex].text;
        
        for (var i = 0; i < serviceDescriptions.length; i++) {
            if (serviceDescriptions[i].name === cat2Text) {
                serviceSummary = serviceDescriptions[i].summary;
                itemUrl = serviceDescriptions[i].serviceItemUrl;
                target = serviceDescriptions[i].target;
            }
        }
        
        document.getElementById("fieldset-title-2").innerHTML = $('#category-1 option:selected').text() + ' ...';
        document.getElementById("fieldset-title-3").innerHTML = $('#category-2 option:selected').text();
        //document.getElementById("fieldset-submit").innerHTML = $('#category-1 option:selected').text();
        
        document.getElementById("fieldset-title-3-text").innerHTML = serviceSummary;
        $("#fieldset-submit").attr("href", itemUrl);
        $("#fieldset-submit").attr("target", target);
    }
    
    $(document).ready(function() {
        
        ResetCategoryAndServices();
        
        $(".field-loading").each(function(a, b){
            $(this).removeClass("field-loading").addClass("field-loaded");
        });
        
        UpdateLabels();    
    });

    $('#category-1').change(function() {
        
        ResetCategoryAndServices();
        
        UpdateLabels();
    });
    
    $('#category-2').change(function() {
        
        UpdateLabels();
    });
</script>

