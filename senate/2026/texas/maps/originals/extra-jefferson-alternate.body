    <script>
        var ems;
        var mobileEmsThreshhold = 48.0625;

        window.onresize = function () {
            ems = window.innerWidth / parseFloat(getComputedStyle(document.querySelector('body'))['font-size']);
            if (ems > mobileEmsThreshhold) {
                //make sure dept. list appears after resize
                document.getElementById('dept-list').style.removeProperty("display");
            }
        }
        ems = window.innerWidth / parseFloat(getComputedStyle(document.querySelector('body'))['font-size']);

        function toggleCollapsible(collEle, on) {

            var content = collEle;
            if (on === true) {
                content.style.display = "block";
            } else {
                content.style.display = "none";

            }
        }

        function toggleCollapsible_CLICK(collEle) {

            var menus = document.getElementsByClassName("header-menu-subMenu");
            for (i = 0; i < menus.length; i++) {
                if (menus[i] != collEle) {
                    menus[i].style.display = 'none';
                }
            }
            var content = collEle;
            if (content.style.display == "" || content.style.display === "none") {
                content.style.display = "block";
            } else {
                content.style.display = "none";
            }

        }

        function toggleCollapsibleSub(collEle, on) {

            var content = collEle;
            if (on === true) {
                content.style.display = "inline";
            } else {
                content.style.display = "none";
            }

        }

        function toggleCollapsibleSub_CLICK(collEle) {

            var content = collEle;
            if (content.style.display == "" || content.style.display === "none") {
                content.style.display = "inline";
            } else {
                content.style.display = "none";
            }

        }

        var coll = document.getElementsByClassName("collapsible");
        var i;


        for (i = 0; i < coll.length; i++) {
            coll[i].addEventListener("click", function () {
                if (ems <= mobileEmsThreshhold) {
                    toggleCollapsible_CLICK(this.getElementsByClassName("header-menu-subMenu")[0])
                }
            });

            coll[i].addEventListener("mouseover", function () {
                if (ems > mobileEmsThreshhold) {
                    toggleCollapsible(this.getElementsByClassName("header-menu-subMenu")[0], true)
                }
            });
            coll[i].addEventListener("mouseleave", function () {
                if (ems > mobileEmsThreshhold) {
                    toggleCollapsible(this.getElementsByClassName("header-menu-subMenu")[0], false)
                }
            });
            coll[i].getElementsByClassName("header-menu-subMenu")[0].addEventListener("mouseleave", function () {
                if (ems > mobileEmsThreshhold) {
                    toggleCollapsible(this, false)
                }
            });
        }


        var coll = document.getElementsByClassName("collapsible-sidemenu");
        var i;
        for (i = 0; i < coll.length; i++) {

            coll[i].addEventListener("click", function () {
                if (ems <= mobileEmsThreshhold) {
                    toggleCollapsible_CLICK(this.nextElementSibling)
                }
            });
        }

        coll = document.getElementsByClassName("collapsible-sub");

        for (i = 0; i < coll.length; i++) {

            coll[i].addEventListener("click", function () {
                if (ems <= mobileEmsThreshhold) {
                    toggleCollapsibleSub_CLICK(this.getElementsByClassName("sidebarMenu sidebar-subMenu")[0])
                }
            });

            coll[i].addEventListener("mouseover", function () {
                if (ems > mobileEmsThreshhold) {
                    toggleCollapsibleSub(this.getElementsByClassName("sidebarMenu sidebar-subMenu")[0], true)
                }
            });
            coll[i].addEventListener("mouseleave", function () {
                if (ems > mobileEmsThreshhold) {
                    toggleCollapsibleSub(this.getElementsByClassName("sidebarMenu sidebar-subMenu")[0], false)
                }
            });

            function isLocal() {
                var http = new XMLHttpRequest();
                http.open("GET", "isLocalRequest.aspx", true);
                http.onreadystatechange = function () {
                    if (http.readyState == 4) {
                        if (http.responseText == "true") {
                            var span = document.getElementById("emails-link");
                            span.style.display = "inline";
                            var portalSpan = document.getElementById("portal-link");
                            portalSpan.style.display = "inline";
                            var portalSpan = document.getElementById("helpdesk-link");
                            portalSpan.style.display = "inline";
                        }
                    }
                }

                http.send();
            }

            isLocal();

        }

    </script>
</body>
