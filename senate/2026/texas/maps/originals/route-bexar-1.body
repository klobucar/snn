            }

            search = String(search);

            try {
                // Preserve the client's regex-string behaviour when valid.
                new RegExp(search, 'g');
                return clientReplaceAll.call(this, search, replacement);
            } catch (error) {
                if (!(error instanceof SyntaxError)) {
                    throw error;
                }

                // Invalid regex strings such as "(" become literal searches.
                return String(this).replace(
                    new RegExp(escapeRegExp(search), 'g'),
                    replacement
                );
            }
        }
    });
})();
