    <!--startindex-->
    
    <h1 class="titlewidget-title"><span>Precinct Maps</span></h1>
    
    <!--stopindex-->
                
                <div class="title_right">
                    <div class="title_row">
                
            <div class="font_size">
                <a role="button" href="javascript:void(0);" title="default font size" class="text_size">Font Size:</a>
                <a role="button" href="javascript:void(0);" title="larger font size" class="font_larger">+</a>
                <a role="button" href="javascript:void(0);" title="smaller font size" class="font_smaller">-</a>
            </div>
            
            <script type="text/javascript">
            function shareLink(shareType) {
                var shareUrl = "";
                var shareTitle = document.itemTitle ? encodeURIComponent(document.itemTitle.trim()).replace(/[!'()*]/g, escape) : "Precinct+Maps";
                switch (shareType) {
                    case "facebook":
                        shareUrl = "http://www.facebook.com/sharer.php?u=https%3a%2f%2fwww.brazoriacountyclerktx.gov%2fdepartments%2felections%2fprecinct-maps&t=" + shareTitle;
                        break;
                    case "linkedin":
                        shareUrl = "http://www.linkedin.com/shareArticle?mini=true&url=https%3a%2f%2fwww.brazoriacountyclerktx.gov%2fdepartments%2felections%2fprecinct-maps&title=" + shareTitle;
                        break;
                    case "twitter":
                        //Below link works in iOS and other OS
                        shareUrl = "https://twitter.com/intent/tweet?url=https%3a%2f%2fwww.brazoriacountyclerktx.gov%2fdepartments%2felections%2fprecinct-maps&text=Precinct+Maps+%7c+";
                        break;
                    case "delicious":
                        shareUrl = "https://secure.delicious.com/login?noui=yes&v=4&jump=https%3a%2f%2fwww.brazoriacountyclerktx.gov%2fdepartments%2felections%2fprecinct-maps%26title%3D" + shareTitle + "%26notes%3D%26tags%3D%26v%3D4%26noui%3D%26share%3Dyes%26jump%3Dclose%26time%3D1239993443";
                        break;
                    case "myspace":
                        shareUrl = "http://www.myspace.com/Modules/PostTo/Pages/?u=https%3a%2f%2fwww.brazoriacountyclerktx.gov%2fdepartments%2felections%2fprecinct-maps&t=" + shareTitle + "&c=";
                        break;
                    case "googlebookmark":
                        shareUrl = "http://www.google.com/bookmarks/mark?op=add&bkmk=https%3a%2f%2fwww.brazoriacountyclerktx.gov%2fdepartments%2felections%2fprecinct-maps&title=" + shareTitle;
                        break;
                    case "stumbleupon":
                        shareUrl = "http://www.stumbleupon.com/submit?url=https%3a%2f%2fwww.brazoriacountyclerktx.gov%2fdepartments%2felections%2fprecinct-maps&title=" + shareTitle;
                        break;
                    case "digg":
