                        break;
                    case "tumblr":
                        shareUrl = "https://www.tumblr.com/share/link?url=https%3a%2f%2fwww.brazoriacountyclerktx.gov%2fdepartments%2felections%2fprecinct-maps&name=" + shareTitle;
                        break;
                    case "reddit":
                        shareUrl = "http://www.reddit.com/submit?url=https%3a%2f%2fwww.brazoriacountyclerktx.gov%2fdepartments%2felections%2fprecinct-maps&title=" + shareTitle;
                        break;
                }
                if (shareUrl.length > 0) window.open(shareUrl, "_blank", "noopener");
            }
            </script>
