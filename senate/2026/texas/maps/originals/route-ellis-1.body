<style>
/* Hide desktop button on mobile */
@media (max-width: 768px) {
  #reciteme-button {
    display: none !important;
  }
}

/* Mobile floating button */
#reciteme-mobile-button {
  display: none;
}

@media (max-width: 768px) {
  #reciteme-mobile-button {
    display: block;
    background: #0166fe;
    width: 72px;
    height: 72px;
    position: fixed;
    bottom: 14px;
    right: 14px;
    border-radius: 50%;
    z-index: 9999;
    cursor: pointer;
  }

  #reciteme-mobile-button img {
    width: 56px;
    height: 56px;
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
  }
}
</style>


