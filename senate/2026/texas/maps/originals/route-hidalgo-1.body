document.addEventListener('DOMContentLoaded', function() {
  const tabList = document.querySelector('ol');
  if (tabList && tabList.querySelector('a[role="tab"]')) {
    tabList.setAttribute('role', 'tablist');
    console.log('Added role="tablist" to the <ol> element.');
  } else {
    console.log('No <ol> with tab elements found.');
  }
});
</script>

<script>
document.addEventListener('DOMContentLoaded', function() {
  // Try multiple ways to find the linked image
  const imgElement = document.querySelector('a img[src*="Hidalgo-County-Logo"]') ||
                     document.querySelector('header a img') ||
                     document.querySelector('a img');
  const linkWithImage = imgElement?.parentElement;

  if (linkWithImage && linkWithImage.tagName === 'A' && !linkWithImage.getAttribute('aria-label') && !linkWithImage.textContent.trim()) {
    linkWithImage.setAttribute('aria-label', 'Hidalgo County Website');
    console.log('Added aria-label "Hidalgo County Website" to <a> tag. Href:', linkWithImage.href, 'Image src:', imgElement?.src);
  } else if (linkWithImage) {
    console.log('Link already has aria-label or text. Current aria-label:', linkWithImage.getAttribute('aria-label'), 
                'Text content:', linkWithImage.textContent.trim(), 'Image src:', imgElement?.src);
  } else {
    console.log('No matching <a> with image found. Checked image:', imgElement);
  }
});
</script></div></div>
