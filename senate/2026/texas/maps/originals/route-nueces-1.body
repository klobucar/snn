            }     
            //VISPP-4466 - we get the cookie value and set the correct stylesheet path for pages without the Page Title widget.
            // Prefer localStorage (same allowlist as Shared/GetFontSizeCookie); AJAX fallback seeds storage for later pageviews.
            var useDesignThemFontSizeCss = window.visionOptions.useDesignThemFontSizeCss;
            var folderPath = useDesignThemFontSizeCss == true ? window.visionOptions.currentDesignFolderPath : window.visionOptions.mainFolderPath;
            if (!folderPath)
                folderPath = window.visionOptions.mainFolderPath;

            var allowedFontSizes = ["xx-small.css", "x-small.css", "small.css", "medium.css", "large.css"];
            var fontSizeStorageKey = (window.visionOptions.virtualApplicationPath || "/").replace(/\//g, "_") + "FontSize";
            var applyFontSize = function (fontSize) {
                $("#active_font").attr("href", folderPath + fontSize).attr("data-css", fontSize);
            };
            var writeFontSizeStorage = function (fontSize) {
                if (allowedFontSizes.indexOf(fontSize) === -1) {
                    return;
                }
                try {
                    window.localStorage.setItem(fontSizeStorageKey, fontSize);
                } catch (e) { }
            };
            var readFontSizeStorage = function () {
                try {
                    var stored = window.localStorage.getItem(fontSizeStorageKey);
                    if (stored && allowedFontSizes.indexOf(stored) !== -1) {
                        return stored;
                    }
                } catch (e) { }
                return null;
            };
            var fetchFontSizeFromCookie = function () {
                var getFontSizeUrl = window.location.origin + window.visionOptions.virtualApplicationPath + "Shared/GetFontSizeCookie";
                var fontSize = "x-small.css";
                $.frontendAjax({
                    url: getFontSizeUrl,
                    type: 'GET',
                    success: function (data) {
                        if (data && data.fontSizeCookie && data.fontSizeCookie != "" && allowedFontSizes.indexOf(data.fontSizeCookie) !== -1) {
                            fontSize = data.fontSizeCookie;
                        }
                        writeFontSizeStorage(fontSize);
                        applyFontSize(fontSize);
                    }
                });
            };

            var storedFontSize = readFontSizeStorage();
            if (storedFontSize) {
                applyFontSize(storedFontSize);
                // Skipping GetFontSizeCookie removes $.frontendAjax ExtendSession side-effect; keep-alive for logged-in FE users.
                var sessionManager = $.frontendSessionManager && $.frontendSessionManager();
                if (sessionManager && sessionManager.opts && sessionManager.opts.frontendUserLogin === true) {
                    sessionManager.extendSessionTimeout(function () { });
                }
            } else {
                fetchFontSizeFromCookie();
            }
        });
    </script>   


    
</body>
</html>