                        shareUrl = "http://www.reddit.com/submit?url=https%3a%2f%2fwww.nuecesco.com%2fcounty-services%2fcounty-clerk%2felections-department%2felection-gis-maps&title=" + shareTitle;
                        break;
                }
                if (shareUrl.length > 0) window.open(shareUrl, "_blank", "noopener");
            }
