<script>
    function addRoleToItemList() {
        const widgetIdentifierClass = "staff_widget_530_2361_1389";
        $("section." + widgetIdentifierClass + " ul.item-list").filter(function () {return !$(this).attr("role");}).attr("role", "none");
    }
    function wrapAllStaffListItems() {
        const section = document.querySelector('section.staff_widget_530_2361_1389');
        if (!section) return;

        const topLevelUl = section.querySelector('ul');
        if (!topLevelUl) return;

        const listItems = topLevelUl.querySelectorAll(':scope > li');

        listItems.forEach(li => {
            const firstChild = li.firstElementChild;

            const isAlreadyWrapped = (firstChild?.tagName?.toLowerCase() === 'div') || 
                (firstChild?.getAttribute('role')?.toLowerCase() === 'group' &&
                firstChild?.getAttribute('aria-label')?.toLowerCase() === 'staff');

            if (!isAlreadyWrapped) {
                const wrapper = document.createElement('div');
                wrapper.setAttribute('role', 'group');
                wrapper.setAttribute('aria-label', 'staff');

                while (li.firstChild) {
                    wrapper.appendChild(li.firstChild);
                }

                li.appendChild(wrapper);
            }
        });
    }

    wrapAllStaffListItems();
    addRoleToItemList();
</script>

