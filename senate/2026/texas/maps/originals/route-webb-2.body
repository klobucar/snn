	<div class="inner col col24 first last ida1b30827-8315-4fe2-bf7b-decff7bc9bdd" style="" data-widgetcontainerid="a1b30827-8315-4fe2-bf7b-decff7bc9bdd">	
<div data-widget-id="a2ac7886-bf43-44b5-8fa4-75862126e247" data-widget-controller-path="/NewsFlash/Widget">
		<script defer src="/Areas/NewsFlash/Assets/Scripts/Carousel.jquery.js" type="text/javascript"></script>
