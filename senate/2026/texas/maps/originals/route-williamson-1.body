			<input class="widgetSearchBox widgetSearchBox0068f54d-af91-4618-a8ce-7e5343db6a41" cp5ph="true" id="searchField0068f54d-af91-4618-a8ce-7e5343db6a41" name="searchField" onchange="searchBtnApplyQuery();" placeholder="Search..." type="text" value="" />
						<a href="/Search/Results" id="btnSearchIcon" class="widgetSearchButton widgetSearchButton0068f54d-af91-4618-a8ce-7e5343db6a41" role="button"><img alt="Search" class="imageHover" data-hover="/ImageRepository/Document?documentID=92" data-image="/ImageRepository/Document?documentID=93" src="/ImageRepository/Document?documentID=93" /></a>

